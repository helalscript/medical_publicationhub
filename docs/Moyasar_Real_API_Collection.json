    {
      "name": "STEP 1 — 🔐 Login (Token নিন)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "",
              "// Try different token field names",
              "var token = null;",
              "if (json.token) token = json.token;",
              "else if (json.data && json.data.token) token = json.data.token;",
              "else if (json.access_token) token = json.access_token;",
              "",
              "if (token) {",
              "    pm.collectionVariables.set('auth_token', token);",
              "    pm.test('✅ Login সফল — Token saved!', function () {",
              "        pm.expect(token).to.be.a('string');",
              "    });",
              "    console.log('Token saved:', token.substring(0, 30) + '...');",
              "} else {",
              "    pm.test('❌ Token পাওয়া যায়নি — response দেখুন', function () {",
              "        pm.expect(json).to.have.property('token');",
              "    });",
              "    console.log('Full response:', JSON.stringify(json));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"your_email@example.com\",\n  \"password\": \"your_password\"\n}",
          "options": {
            "raw": { "language": "json" }
