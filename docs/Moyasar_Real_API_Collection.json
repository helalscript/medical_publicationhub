    {
      "name": "STEP 6 — 🔔 Webhook Simulate (Force Paid → DB Update)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Exact payload build করতে হবে — JSON.stringify এর order matter করে",
              "var paymentId = pm.collectionVariables.get('payment_gateway_id');",
              "var secret = pm.collectionVariables.get('webhook_secret');",
              "",
              "if (!paymentId || paymentId === '') {",
              "    console.error('❌ payment_gateway_id empty! Step 3 আগে run করুন।');",
              "}",
              "",
              "if (!secret || secret === '') {",
              "    console.warn('⚠️ webhook_secret empty! .env এর MOYASAR_WEBHOOK_SECRET দিন।');",
              "}",
              "",
              "var payload = JSON.stringify({",
              "    id: 'evt_postman_' + Date.now(),",
              "    type: 'payment.paid',",
              "    data: {",
              "        id: paymentId,",
              "        status: 'paid',",
              "        amount: 15000,",
              "        currency: 'SAR'",
              "    }",
              "});",
              "",
              "pm.collectionVariables.set('_webhook_payload_temp', payload);",
              "",
              "// HMAC-SHA256 signature generate",
              "var signature = CryptoJS.HmacSHA256(payload, secret).toString(CryptoJS.enc.Hex);",
              "pm.collectionVariables.set('webhook_signature', signature);",
              "",
              "console.log('Payment ID:', paymentId);",
              "console.log('Payload:', payload);",
              "console.log('Signature:', signature);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('✅ Webhook received (200)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var json = pm.response.json();",
              "pm.test('✅ status: success আছে', function () {",
              "    pm.expect(json.status).to.equal('success');",
              "});",
              "",
              "console.log('Webhook Response:', JSON.stringify(json, null, 2));",
              "console.log('✅ DB-তে payment status paid হওয়া উচিত। Step 4 দিয়ে verify করুন।');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" },
          {
            "key": "x-moyasar-signature",
            "value": "{{webhook_signature}}",
            "description": "Pre-request script এ auto-generate হয়"
